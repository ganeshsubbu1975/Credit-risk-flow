{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (.NET API)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/src/LoanUnderwriting.Api/bin/Debug/net8.0/LoanUnderwriting.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/src/LoanUnderwriting.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5000" },
      "console": "integratedTerminal"
    },
    {
      "name": "Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "preLaunchTask": "kill-frontend",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Browser (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": ["Backend (.NET API)", "Frontend (Vite)"],
      "stopAll": true
    }
  ]
}
