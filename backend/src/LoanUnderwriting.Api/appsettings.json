{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",

  "Deployment": { "Mode": "OnPrem" },

  "Database": {
    "ConnectionString": "Server=YOUR_SERVER;Database=LoanUnderwriting;Integrated Security=True;TrustServerCertificate=True",
    "VectorProvider": "Native",
    "AutoCreateSchema": true
  },

  "Storage": { "DocumentFolder": "data/documents", "MaxUploadMb": 20 },

  "Models": {
    "OnPrem": {
      "Provider": "OpenAiCompatible",
      "BaseUrl": "http://localhost:5273/v1",
      "AuthMode": "None",
      "TimeoutSeconds": 180,
      "Models": {
        "Extraction": "REPLACE_WITH_FOUNDRY_LOCAL_MODEL_ID",
        "Compliance": "REPLACE_WITH_FOUNDRY_LOCAL_MODEL_ID",
        "Risk": "REPLACE_WITH_FOUNDRY_LOCAL_MODEL_ID",
        "ScopeCheck": "REPLACE_WITH_FOUNDRY_LOCAL_MODEL_ID",
        "QaAnswer": "REPLACE_WITH_FOUNDRY_LOCAL_MODEL_ID"
      },
      "EmbeddingModel": "REPLACE_WITH_FOUNDRY_LOCAL_EMBEDDING_MODEL_ID",
      "EmbeddingDimensions": 768
    },
    "Azure": {
      "Provider": "OpenAiCompatible",
      "BaseUrl": "https://YOUR-RESOURCE.openai.azure.com/openai/v1",
      "AuthMode": "AzureAd",
      "AzureScope": "https://cognitiveservices.azure.com/.default",
      "TimeoutSeconds": 120,
      "Models": {
        "Extraction": "YOUR-DEPLOYMENT-NAME",
        "Compliance": "YOUR-DEPLOYMENT-NAME",
        "Risk": "YOUR-DEPLOYMENT-NAME",
        "ScopeCheck": "YOUR-DEPLOYMENT-NAME",
        "QaAnswer": "YOUR-DEPLOYMENT-NAME"
      },
      "EmbeddingModel": "YOUR-EMBEDDING-DEPLOYMENT-NAME",
      "EmbeddingDimensions": 1536
    }
  },

  "Qa": { "TopK": 6, "MaxDistance": 0.6 },
  "Workflow": { "MaxConcurrentRuns": 2, "ExtractionRetries": 1 },
  "SelfCheck": { "Enabled": true, "ProbeModels": true },

  "Auth": {
    "Mode": "Jwt",
    "Authority": "https://YOUR-IDP/",
    "Audience": "loan-underwriting-api",
    "RoleClaim": "roles"
  },
  "Cors": { "Origins": [ "http://localhost:5173" ] }
}
