{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",

  "Deployment": { "Mode": "Azure" },

  "Database": {
    "ConnectionString": "Server=YOUR_SERVER;Database=LoanUnderwriting;Integrated Security=True;TrustServerCertificate=True",
    "VectorProvider": "Native",
    "AutoCreateSchema": true
  },

  "Storage": { "Provider": "File", "DocumentFolder": "data/documents", "MaxUploadMb": 20 },

  "Models": {
    "OnPrem": {
      "Provider": "OpenAiCompatible",
      "BaseUrl": "http://localhost:5273/v1",
      "AuthMode": "None",
      "TimeoutSeconds": 180,
      "Models": {
        "Extraction": "Phi-4-mini-instruct-generic-gpu:5",
        "Compliance": "Phi-4-mini-instruct-generic-gpu:5",
        "Risk": "Phi-4-mini-instruct-generic-gpu:5",
        "ScopeCheck": "Phi-4-mini-instruct-generic-gpu:5",
        "QaAnswer": "Phi-4-mini-instruct-generic-gpu:5"
      },
      "EmbeddingProvider": "Stub",
      "EmbeddingModel": "stub-embedding",
      "EmbeddingDimensions": 1024
    },
    "Azure": {
      "Provider": "OpenAiCompatible",
      "BaseUrl": "https://ganeshfoundry.openai.azure.com/openai/v1",
      "AuthMode": "AzureAd",
      "AzureScope": "https://cognitiveservices.azure.com/.default",
      "TimeoutSeconds": 120,
      "Models": {
        "Extraction": "gpt-5.4-mini",
        "Compliance": "gpt-5.4-mini",
        "Risk": "gpt-5.4-mini",
        "ScopeCheck": "gpt-5.4-mini",
        "QaAnswer": "gpt-5.4-mini"
      },
      "EmbeddingModel": "text-embedding-3-small",
      "EmbeddingDimensions": 1536
    }
  },

  "Qa": { "TopK": 20, "MaxDistance": 0.85 },
  "Workflow": { "MaxConcurrentRuns": 1, "ExtractionRetries": 1 },
  "SelfCheck": { "Enabled": true, "ProbeModels": true },

  "Auth": {
    "Mode": "Jwt",
    "Authority": "https://YOUR-IDP/",
    "Audience": "loan-underwriting-api",
    "RoleClaim": "roles"
  },
  "Cors": { "Origins": [ "http://localhost:5173", "http://localhost:5174" ] }
}
